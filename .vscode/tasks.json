{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "dotnet",
			"task": "build",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": [],
			"label": "dotnet: build"
		},
		{
			"group": {
				"kind": "build"
			},
			"command": "dotnet",
			"args": ["build", "-p:TargetFrameworks=net8.0"],
			"problemMatcher": [],
			"label": "dotnet: build (net8.0 only)"
		},
		{
			"group": {
				"kind": "build"
			},
			"command": "dotnet",
			"args": ["pack", "-o", "packages"],
			"problemMatcher": [],
			"label": "dotnet: pack"
		},
		{
			"group": {
				"kind": "none"
			},
			"command": "dotnet",
			"args": ["clean"],
			"problemMatcher": [],
			"label": "dotnet: clean"
		},
		{
			"group": {
				"kind": "test",
				"isDefault": true
			},
			"command": "dotnet",
			"args": ["test"],
			"problemMatcher": [],
			"label": "dotnet: test"
		},
		{
			"group": {
				"kind": "test"
			},
			"type": "shell",
			"command": "npm",
			"args": ["run", "test"],
			"problemMatcher": [],
			"label": "npm: test (JsonToHtmlReport)",
			"options": {
				"cwd": "${workspaceFolder}/CSF.Screenplay.JsonToHtmlReport.Template/src"
			}
		},
		{
			"group": {
				"kind": "build"
			},
			"command": "dotnet",
			"args": ["build", "-c", "Docs"],
			"problemMatcher": [],
			"label": "Build docs website",
			"options": {"cwd": "${workspaceFolder}"}
		},
		{
			"group": {
				"kind": "build"
			},
			"command": "docfx",
			"args": ["CSF.Screenplay.Docs/docfx.json", "--serve"],
			"problemMatcher": [],
			"label": "Serve docs website"
		},
		{
			"group": {
				"kind": "build"
			},
			"type": "shell",
			"command": "npm",
			"args": ["i"],
			"problemMatcher": [],
			"label": "npm: install (JsonToHtmlReport)",
			"options": {
				"cwd": "${workspaceFolder}/CSF.Screenplay.JsonToHtmlReport.Template/src"
			}
		},
		{
			"group": {
				"kind": "build"
			},
			"type": "shell",
			"command": "npm",
			"args": ["run", "dev"],
			"problemMatcher": [],
			"label": "npm: dev (JsonToHtmlReport)",
			"options": {
				"cwd": "${workspaceFolder}/CSF.Screenplay.JsonToHtmlReport.Template/src"
			}
		},
		{
			"group": {
				"kind": "build"
			},
			"type": "shell",
			"command": "npm",
			"args": ["run", "build"],
			"problemMatcher": [],
			"label": "npm: build (JsonToHtmlReport)",
			"options": {
				"cwd": "${workspaceFolder}/CSF.Screenplay.JsonToHtmlReport.Template/src"
			}
		},
		{
			"group": {
				"kind": "build"
			},
			"type": "shell",
			"command": "npm",
			"args": ["i"],
			"problemMatcher": [],
			"label": "npm: install (SimpleToDoApp)",
			"options": {
				"cwd": "${workspaceFolder}/Samples/CSF.Screenplay.Samples.SimpleToDoApp"
			}
		},
		{
			"group": {
				"kind": "build"
			},
			"type": "shell",
			"command": "npm",
			"args": ["run", "build"],
			"problemMatcher": [],
			"label": "npm: build (SimpleToDoApp)",
			"options": {
				"cwd": "${workspaceFolder}/Samples/CSF.Screenplay.Samples.SimpleToDoApp"
			}
		},
		{
			"group": {
				"kind": "build"
			},
			"type": "shell",
			"command": "npm",
			"args": ["run", "dev"],
			"problemMatcher": [],
			"label": "npm: dev (SimpleToDoApp)",
			"options": {
				"cwd": "${workspaceFolder}/Samples/CSF.Screenplay.Samples.SimpleToDoApp"
			}
		},
		{
			"group": {
				"kind": "build"
			},
			"type": "shell",
			"command": "npm",
			"args": ["run", "serve"],
			"problemMatcher": [],
			"label": "npm: serve (SimpleToDoApp)",
			"options": {
				"cwd": "${workspaceFolder}/Samples/CSF.Screenplay.Samples.SimpleToDoApp"
			}
		}
	]
}